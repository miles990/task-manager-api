{
  "name": "task-manager-api",
  "version": "1.0.0",
  "description": "Claude Code 最佳實踐範例專案 - 任務管理 API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.js' 'tests/**/*.js'",
    "typecheck": "tsc --noEmit",
    "pre-commit": "npm run format && npm run lint && npm run test"
  },
  "keywords": ["api", "task-manager", "claude-code", "best-practices"],
  "author": "Claude Code Demo",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  }
}